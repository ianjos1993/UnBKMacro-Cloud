<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Атака одной кнопкой, на любой скил или пета, возможностей неограниченно, смотрите сами на что применять </Description>
    <Comment>https://botmek.com - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 86400000 ms
KeyUp 30 1
Delay 86400000 ms</Syntax>
    </KeyDown>
    <Software>Rappelz</Software>
  </DefaultMacro>
</Root>