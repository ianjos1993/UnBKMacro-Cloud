<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>This file will help u farm with your pets. Put pet attack on " spaace " button and all u have to do is  just using your mous to move aaround </Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 44 1
Delay 64 ms
KeyUp 44 1
GoWhile 1 86400000</Syntax>
    </KeyDown>
    <Software>Rappelz</Software>
  </DefaultMacro>
</Root>