    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 25 ms
KeyUp 30 1
Delay 25 ms</Syntax>
    </KeyDown>
    <Software>Rappelz</Software>
