<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>this walldash is used for when the wall is to your left.... make sure your air roll left is A and your jump is Right click</Description>
    <Comment>Rocket League Left Wall dash</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 4 1
RightDown 1
Delay 60 ms
RightDown 1
KeyDown 4 1
Delay 60 ms
RightDown 1
KeyDown 4 1
Delay 60 ms
RightDown 1
KeyDown 4 1
Delay 60 ms
RightDown 1
KeyDown 4 1
Delay 60 ms
GoWhile 1 60</Syntax>
    </KeyDown>
    <Software>Rocket League</Software>
  </DefaultMacro>
</Root>