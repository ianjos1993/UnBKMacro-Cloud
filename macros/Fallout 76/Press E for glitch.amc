<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>E repeat  for Stack Glitching. Repeats 200 times, may need to edit depending on your disconnection timeframe.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 8 1
Delay 0 ms
KeyUp 8 1
Delay 0 ms
GoWhile 1 200</Syntax>
    </KeyDown>
    <Software>Fallout 76</Software>
  </DefaultMacro>
</Root>