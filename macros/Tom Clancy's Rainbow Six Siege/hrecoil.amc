<Root>
  <DefaultMacro>
    <Major>works best on guns with high recoil</Major>
    <Description>put this macro on left click then run while holding

sens: 8y 8x 800 dpi

res: 1920x1080 144hz

aspect ratio: auto, 90 fov </Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 15 ms
MoveR 6 18
Delay 15 ms
MoveR 0 30
Delay 15 ms
MoveR 0 15
Delay 15 ms
MoveR -8 10
Delay 15 ms</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>