      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 15 ms
MoveR 0 9
Delay 15 ms
MoveR -1 9
Delay 15 ms
MoveR -1 9
Delay 15 ms
MoveR 6 9
Delay 15 ms</Syntax>
    </KeyDown>
