<Root>
  <DefaultMacro>
    <Major>r6 for lower recoil guns</Major>
    <Description>left mouse button, 800 DPI, horizontal 8-12, vertical 10, 50 ADS, resolution 1920x1080, 16:10 format, suitable for azami doc ash etc</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 20 ms
MoveR 0 14
Delay 20 ms</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>