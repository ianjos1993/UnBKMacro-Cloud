<Root>
  <DefaultMacro>
    <Major>for high recoil guns</Major>
    <Description>The left mouse button should be set to 800 DPI: horizontal 9, vertical 11, at 50 ADS and a resolution of 1920x1080 (16:10). If you have any questions, please write.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 19 ms
MoveR 2 12
Delay 19 ms
MoveR 2 11
Delay 19 ms
MoveR 2 11
Delay 19 ms
MoveR 2 12
Delay 19 ms
MoveR 1 10
Delay 19 ms
MoveR -1 11
LeftUp 1</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>