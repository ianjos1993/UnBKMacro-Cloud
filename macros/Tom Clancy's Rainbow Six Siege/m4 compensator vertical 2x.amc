<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>this macro removes pretty mutch all of the m4 recoil (maveric striker)
in game settings:
fov 84
1920x1080
sens 6
dpi 800

m4 attachments:
compensator
vertical grip
magnified scope</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR 0 3
Delay 2 ms
MoveR 0 3
Delay 2 ms
MoveR 0 3
Delay 2 ms
MoveR -1 3
Delay 2 ms
MoveR 0 3
Delay 2 ms
MoveR 0 3
Delay 2 ms
MoveR 0 4
Delay 2 ms
MoveR 0 3</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>