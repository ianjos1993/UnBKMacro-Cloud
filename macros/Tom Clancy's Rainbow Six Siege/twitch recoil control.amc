<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>this macro removes pretty mutch all of the recoil for twitch aswell as the smg 12
in game settings:
fov 84
1920x1080
sens 6
dpi 800
1x 40
2.5x 50


</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 6 ms
MoveR -2 11
Delay 6 ms
MoveR -1 12
Delay 6 ms
MoveR 1 12
Delay 6 ms
MoveR 0 11
Delay 6 ms
MoveR -2 13
Delay 6 ms
MoveR -1 12
Delay 10 ms
MoveR 1 13
Delay 10 ms</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>