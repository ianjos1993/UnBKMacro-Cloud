<Root>
  <DefaultMacro>
    <Major>works best for weapons with low recoil</Major>
    <Description>macro for low recoil weapons. put it on left click 

sens: 12y 12x, 800 dpi 

res: 1920 x1080, 144hz

aspect rario: 4:3, 90 fov</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 64
Delay 0 ms
MoveR 1 5
Delay 8 ms
MoveR 0 6
Delay 8 ms
MoveR -1 5
Delay 8 ms
MoveR -2 5
Delay 5 ms</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>