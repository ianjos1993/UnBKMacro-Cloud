<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>this macro removes pretty mutch all of the ying lmg recoil
in game settings:
fov 84
1920x1080
sens 6
dpi 800
1x 40

compensator 
vertical grip
1.5x</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR -2 3
Delay 2 ms
MoveR 5 3
Delay 2 ms
MoveR -3 3
Delay 2 ms
MoveR 4 3
Delay 2 ms
MoveR -2 3
Delay 2 ms
MoveR 5 3
Delay 2 ms
MoveR -4 4
Delay 2 ms
MoveR -3 3</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>