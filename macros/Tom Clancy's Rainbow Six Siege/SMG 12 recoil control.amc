<Root>
  <DefaultMacro>
    <Major>Gets rid of recoil for SMG 12</Major>
    <Description>Bind to left mouse button (shoot button)
1920x1080
800 dpi on mouse 
8-12 horizontal
8-12 verticle
65 ads 
16:10 i dont think it matters tho

Works best with the SMG 12
</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 15 ms
MoveR 3 14
Delay 15 ms
MoveR 3 14
Delay 15 ms
MoveR 3 14
Delay 15 ms
MoveR -1 14
Delay 15 ms</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
