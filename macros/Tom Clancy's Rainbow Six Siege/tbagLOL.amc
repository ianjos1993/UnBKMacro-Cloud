<Root>
  <DefaultMacro>
    <Major>TBAG</Major>
    <Description>TBAG para R6 para boludear y demás haciendo CROUCH SPAM super fast y está buenisimo porque todo se puede personalizar y demas y que locura amigooo</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 224 1
Delay 20 ms
KeyUp 224 1
Delay 20 ms</Syntax>
    </KeyDown>
    <Software>Tom Clancy's Rainbow Six Siege</Software>
  </DefaultMacro>
</Root>