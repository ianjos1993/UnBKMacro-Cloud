<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Макрос для АОЕ фарма за берса, выставляем массухи,раш и дальний нексттаргет на панель от F1 до F5 и наслаждаемся афк фармом</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 61 1
Delay 64
KeyUp 61 1
Delay 64
KeyDown 60 1
Delay 64
KeyUp 60 1
Delay 64
KeyDown 58 1
Delay 64
KeyUp 58 1
Delay 64
KeyDown 61 1
Delay 64
KeyUp 61 1
Delay 64
KeyDown 60 1
Delay 64
KeyUp 60 1
Delay 64
KeyDown 59 1
Delay 64
KeyUp 59 1
Delay 64
KeyDown 61 1
Delay 64
KeyUp 61 1
Delay 64
KeyDown 60 1
Delay 64
KeyUp 60 1
Delay 64
KeyDown 62 1
Delay 64
KeyUp 62 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Lineage 2</Software>
  </DefaultMacro>
</Root>