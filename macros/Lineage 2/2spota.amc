<Root>
  <DefaultMacro>
    <Major>Макрос на 2 спота для сх/сорка</Major>
    <Description>Ставите скилы на следующие кнопки:
F1 - некст таргет
1 - прыжок вперед
2 - таргет на пета, 3 - таргет на второго пета
F2 - F8  - атакующие скилы
В зависимости от спота, можете изменять время ожидания между прожатием кнопок 2,3 (на ближних спотах ставлю 1000 мс, на дальних 2000-3000 мс)  и количество циклов на атакющих скилах</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 31 1
Delay 1850 ms
KeyUp 31 1
Delay 1850 ms
KeyDown 30 1
KeyUp 30 1
KeyDown 58 1
Delay 5 ms
KeyUp 58 1
Delay 5 ms
KeyDown 59 1
Delay 5 ms
KeyUp 59 1
Delay 5 ms
KeyDown 60 1
Delay 5 ms
KeyUp 60 1
Delay 5 ms
KeyDown 61 1
Delay 5 ms
KeyUp 61 1
Delay 5 ms
KeyDown 62 1
Delay 5 ms
KeyUp 62 1
Delay 5 ms
KeyDown 63 1
Delay 5 ms
KeyUp 63 1
Delay 5 ms
KeyDown 64 1
Delay 5 ms
KeyUp 64 1
Delay 5 ms
KeyDown 65 1
Delay 5 ms
KeyUp 65 1
Delay 5 ms
GoWhile 7 170
KeyDown 32 1
Delay 1850 ms
KeyUp 32 1
Delay 1850 ms
KeyDown 30 1
KeyUp 30 1
KeyDown 58 1
Delay 5 ms
KeyUp 58 1
Delay 5 ms
KeyDown 59 1
Delay 5 ms
KeyUp 59 1
Delay 5 ms
KeyDown 60 1
Delay 5 ms
KeyUp 60 1
Delay 5 ms
KeyDown 61 1
Delay 5 ms
KeyUp 61 1
Delay 5 ms
KeyDown 62 1
Delay 5 ms
KeyUp 62 1
Delay 5 ms
KeyDown 63 1
Delay 5 ms
KeyUp 63 1
Delay 5 ms
KeyDown 64 1
Delay 5 ms
KeyUp 64 1
Delay 5 ms
KeyDown 65 1
Delay 5 ms
KeyUp 65 1
Delay 5 ms
GoWhile 46 170</Syntax>
    </KeyDown>
    <Software>Lineage 2</Software>
  </DefaultMacro>
</Root>