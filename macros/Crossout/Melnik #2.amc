<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Мельники стреляют с большими разбросами, что лучше стрелять вблизи. Вы можете скачать мой 1 макрос чтобы стрелять точечно.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 11500 ms
LeftUp 1
Delay 30 ms
KeyDown 30 1
Delay 11500 ms
KeyUp 30 1
Delay 30 ms
KeyDown 31 1
Delay 11500 ms
KeyUp 31 1
Delay 30 ms</Syntax>
    </KeyDown>
    <Software>Crossout</Software>
  </DefaultMacro>
</Root>