KeyDown 25 1
Delay 5
KeyUp 25 1
Delay 5
KeyDown 25 1
Delay 5
KeyUp 25 1
Delay 5
KeyDown 25 1
Delay 5
KeyUp 25 1
Delay 5
KeyDown 6 1
Delay 5
KeyUp 6 1
Delay 5
KeyDown 33 1
Delay 5
KeyUp 33 1
Delay 5
KeyDown 23 1
Delay 5
KeyUp 23 1
Delay 5</Syntax>
    </KeyDown>
    <Software>Blade &amp; Soul</Software>
  </DefaultMacro>
</Root>