      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 100 ms
LeftUp 1
Delay 1 ms
KeyDown 9 1
Delay 100 ms
