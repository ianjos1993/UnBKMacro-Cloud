<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Запускаем самп или ГТА
садимся на велик
нажимаем забинженную кнопку
воуля у нас челик едет как бешенный</Description>
    <Comment>https://botmek.com - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 26 1
KeyUp 26 1</Syntax>
    </KeyDown>
    <Software>SAMP</Software>
  </DefaultMacro>
</Root>