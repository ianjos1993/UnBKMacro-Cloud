*ПОЛЬЗУЙТЕСЬ С УДОВОЛЬСТВИЕМ**</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR 0 3
Delay 20 ms
MoveR 0 4
Delay 15 ms
MoveR 0 2
Delay 10 ms
MoveR 2 0
Delay 10 ms
MoveR 0 3
Delay 10 ms
MoveR 0 2
Delay 10 ms
MoveR 3 0
Delay 10 ms
MoveR 1 0
Delay 10 ms
MoveR 0 -3
Delay 10 ms
LeftUp 1</Syntax>
    </KeyDown>
    <Software>StalCraft</Software>
  </DefaultMacro>
</Root>