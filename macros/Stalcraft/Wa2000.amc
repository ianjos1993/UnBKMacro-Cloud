*********************************************ПОЛЬЗУЙТЕСЬ С УДОВОЛЬСТВИЕМ**************************************************</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR 0 3
Delay 20 ms
LeftUp 1</Syntax>
    </KeyDown>
    <Software>StalCraft</Software>
  </DefaultMacro>
</Root>