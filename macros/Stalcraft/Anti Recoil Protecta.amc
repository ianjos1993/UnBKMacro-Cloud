    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR 0 1
Delay 10 ms
MoveR 2 0
Delay 10 ms
MoveR 0 2
Delay 10 ms
MoveR 2 0
Delay 10 ms
MoveR 0 3
Delay 16 ms
LeftUp 1</Syntax>
    </KeyDown>
    <Software>StalCraft</Software>
  </DefaultMacro>
