      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 26 1
KeyUp 26 1
Delay 30000 ms
KeyDown 7 1
KeyUp 7 1
Delay 30000 ms
KeyDown 22 1
