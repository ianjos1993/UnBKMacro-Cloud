<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Квест скурить 100 нарко ставте нарко на 5 слот и запускайте,автоматом будет курить кокс или травку каждые 2 минуты</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 34 1
Delay 64
KeyUp 34 1
Delay 64
Delay 2 min</Syntax>
    </KeyDown>
    <Software>GTA 5 RP</Software>
  </DefaultMacro>
</Root>