<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Place car scanner in quick slot number 1 of your inventory . Once assigned to a key, scanner will keep pinging for car position until deactivated</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 2000 ms
KeyUp 30 1
Delay 2000 ms</Syntax>
    </KeyDown>
    <Software>GTA 5 RP</Software>
  </DefaultMacro>
</Root>