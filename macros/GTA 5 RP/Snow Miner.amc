<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>This macro Mines Snow automatically for you, just put spade in slot 3, then assign to key. Easy! No captcha either at the moment, so easy farm.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 32 1
Delay 64
KeyUp 32 1
Delay 5000 ms
Delay 64
GoWhile 1 86400000</Syntax>
    </KeyDown>
    <Software>GTA 5 RP</Software>
  </DefaultMacro>
</Root>