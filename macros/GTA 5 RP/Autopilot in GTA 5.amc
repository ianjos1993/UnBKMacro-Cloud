Delay 667 ms
KeyDown 19 1
Delay 91 ms
KeyUp 19 1
Delay 324 ms
KeyDown 15 1
Delay 73 ms
KeyUp 15 1
Delay 181 ms
KeyDown 4 1
Delay 67 ms
KeyUp 4 1
Delay 350 ms
KeyDown 17 1
Delay 73 ms
KeyUp 17 1
Delay 101 ms
KeyDown 8 1
Delay 72 ms
KeyUp 8 1
Delay 678 ms
KeyDown 88 1
Delay 73 ms
KeyUp 88 1
Delay 2631 ms
KeyDown 8 1
Delay 85 ms
KeyUp 8 1
KeyDown 26 1
Delay 520 ms
KeyUp 26 1
Goto 49</Syntax>
    </KeyDown>
    <Software>GTA 5 RP</Software>
  </DefaultMacro>
</Root>