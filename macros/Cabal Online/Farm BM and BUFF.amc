KeyDown 30 1
KeyUp 30 1
Delay 64 ms
KeyDown 31 1
KeyUp 31 1
Delay 64 ms
KeyDown 32 1
KeyUp 32 1
Delay 64 ms
KeyDown 33 1
KeyUp 33 1
Delay 64 ms
KeyDown 34 1
KeyUp 34 1
KeyDown 44 1
KeyUp 44 1
KeyDown 44 1
KeyUp 44 1
KeyDown 44 1
KeyUp 44 1
KeyDown 44 1
KeyUp 44 1</Syntax>
    </KeyDown>
    <Software>Cabal Online</Software>
  </DefaultMacro>
</Root>