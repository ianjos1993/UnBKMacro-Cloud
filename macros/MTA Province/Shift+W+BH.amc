Delay 164 ms
KeyUp 44 1
Delay 856 ms
KeyDown 44 1
Delay 194 ms
KeyUp 44 1
Delay 816 ms
KeyDown 44 1
Delay 144 ms
KeyUp 44 1
Delay 2437 ms</Syntax>
    </KeyDown>
    <Software>MTA Province</Software>
  </DefaultMacro>
</Root>