<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Скрипт предназначеный для игры DayZ, для подбора 3-х значного кодового замка.
В случае некоректной работы надо увеличть время задержки/ зажатия клавишь примерно на 100-150 мс.
Подбор замка нужно начинать с нулей.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 9 1
Delay 5700 ms
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 1500 ms
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 s
GoWhile 1 10
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 1500 ms
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 64
GoWhile 1 10
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 ms
KeyDown 9 1
Delay 64 ms
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 64
KeyUp 9 1
Delay 1 s
KeyDown 9 1
Delay 1500 ms
KeyUp 9 1
Delay 1 s
GoWhile 1 10</Syntax>
    </KeyDown>
    <Software>DayZ</Software>
  </DefaultMacro>
</Root>