KeyUp 20 1
Delay 2
KeyDown 20 1
Delay 2
KeyUp 20 1
Delay 2
KeyDown 20 1
Delay 2
KeyUp 20 1
Delay 2</Syntax>
    </KeyDown>
    <Software>Albion online</Software>
  </DefaultMacro>
</Root>