      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>MoveTo 1303 391 1401 422
Delay 20 ms
LeftDown 1
Delay 20 ms
LeftUp 1
Delay 20 ms
MoveTo 1032 609 1162 635
Delay 20 ms
