<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Билд на фаст прокаст тинкера
q - Лазер
w - Ракетки
x - Шива
c - Хекс или Дагон(как вам больше нравится)
tab - соул ринг</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы 
Спасибо что сказачали мой макросик</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 44 1
Delay 50
KeyUp 44 1
Delay 50
KeyDown 43 1
Delay 50
KeyUp 43 1
Delay 50
KeyDown 26 1
Delay 50
KeyUp 26 1
Delay 50
KeyDown 27 1
Delay 50
KeyUp 27 1
Delay 50
KeyDown 20 1
Delay 50
KeyUp 20 1
Delay 50
KeyDown 6 1
Delay 50
KeyUp 6 1
Delay 50</Syntax>
    </KeyDown>
    <Software>Dota 2</Software>
  </DefaultMacro>
</Root>