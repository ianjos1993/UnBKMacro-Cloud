Delay 25 30 ms
KeyUp 21 1
Delay 50 ms
Delay 50 ms
KeyDown 20 1
Delay 25 30 ms
KeyUp 20 1</Syntax>
    </KeyDown>
    <Software>Dota 2</Software>
  </DefaultMacro>
</Root>