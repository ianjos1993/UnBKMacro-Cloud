      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 226 1
LeftDown 1
Delay 64
LeftUp 1
Delay 64
LeftDown 1
Delay 64
LeftUp 1
