Delay 9 ms
KeyDown 31 1
Delay 6 ms
KeyUp 31 1
Delay 3 ms
KeyDown 26 1
Delay 4 ms
KeyUp 26 1
Delay 12 ms
KeyDown 33 1
Delay 9 ms
KeyUp 33 1
Delay 15 ms</Syntax>
    </KeyDown>
    <Software>Dota 2</Software>
  </DefaultMacro>
</Root>