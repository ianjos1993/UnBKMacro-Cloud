      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 20 1
Delay 3 ms
KeyUp 20 1
Delay 3 ms
LeftDown 1
Delay 11 ms
LeftUp 1
Delay 3 ms
