Delay 11 ms
KeyDown 26 1
KeyDown 26 1
KeyDown 27 1
Delay 16 ms
KeyUp 27 1
Delay 15 ms</Syntax>
    </KeyDown>
    <Software>Dota 2</Software>
  </DefaultMacro>
</Root>