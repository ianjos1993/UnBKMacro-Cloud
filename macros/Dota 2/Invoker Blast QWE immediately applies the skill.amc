      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
