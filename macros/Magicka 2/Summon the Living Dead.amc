<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Призови группу из 6 скелетов-воинов, которые будут искать врагов и наносить им небольшой физический урон</Description>
    <Comment>Глава 6 - Завершите главу</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 21 1
Delay 64
KeyUp 21 1
Delay 64
KeyDown 7 1
Delay 64
KeyUp 7 1
Delay 64
KeyDown 22 1
Delay 64
KeyUp 22 1
Delay 64
KeyDown 21 1
Delay 64
KeyUp 21 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Magicka 2</Software>
  </DefaultMacro>
</Root>