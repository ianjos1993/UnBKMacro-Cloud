      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 9 1
Delay 50
KeyDown 9 1
Delay 50
KeyDown 9 1
Delay 50</Syntax>
    </KeyDown>
