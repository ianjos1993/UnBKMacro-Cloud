<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>запуск: на персанаже кэйа, без отката на способность, подойдите к воде, и нажмите кнопку, запускающую макрос.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 8 1
Delay 89 ms
KeyUp 8 1
Delay 811 ms
KeyDown 26 1
Delay 1382 ms
KeyUp 26 1
Delay 4175 ms</Syntax>
    </KeyDown>
    <Software>Genshin Impact</Software>
  </DefaultMacro>
</Root>