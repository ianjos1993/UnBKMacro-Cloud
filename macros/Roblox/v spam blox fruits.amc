<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>данный макро сделан для афк фарма с помошью грома в 2 и 3 мире на специальных точках игры. используется новечками</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 25 1
Delay 1 ms
KeyUp 25 1
Delay 1 ms
KeyDown 25 1
Delay 1 ms
KeyUp 25 1
Delay 1 ms
KeyDown 25 1
Delay 1 ms
KeyUp 25 1
Delay 1 ms
KeyDown 25 1
Delay 1 ms
KeyUp 25 1</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>