<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>it will keep you from disconnecting on roblox so,,, that you can afk and get something to eat or drink or go buy something at the shops</Description>
    <Comment>no disconnect</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 4 1
Delay 64
KeyDown 7 1
Delay 64
KeyUp 4 1
Delay 64
KeyUp 7 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>