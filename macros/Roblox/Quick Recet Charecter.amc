<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Быстрый Ресет для Roblox. Может понадобиться в играх , в которых нужно очень долго фармить предметы.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 41 1
Delay 24 ms
KeyUp 41 1
Delay 24 ms
KeyDown 21 1
Delay 24 ms
KeyUp 21 1
Delay 24 ms
KeyDown 21 1
Delay 24 ms
KeyUp 21 1
Delay 24 ms</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>