      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 44 1
Delay 7 ms
KeyUp 44 1
Delay 7 ms
KeyDown 20 1
Delay 7 ms
