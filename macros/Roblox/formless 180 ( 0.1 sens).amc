    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>MoveR -4300 0
Delay 0 ms</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
