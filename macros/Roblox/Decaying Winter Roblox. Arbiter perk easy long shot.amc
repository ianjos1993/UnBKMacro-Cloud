<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Arbiter easy Long shot

easier then that! - https://www.youtube.com/watch?v=j1Fxpf3tnRA

Good luck agent!</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 9 1
Delay 147 ms
KeyUp 9 1
Delay 388 ms
KeyDown 9 1
Delay 103 ms
KeyUp 9 1</Syntax>
    </KeyDown>
    <Software>Roblox, Decaying winter</Software>
  </DefaultMacro>
</Root>