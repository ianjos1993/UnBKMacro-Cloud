<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Automatically takes out ur boxing gloves and perfomes a haymaker then puts the glove back out good for perfoming high damage,</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы w</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 64
KeyUp 30 1
Delay 64
KeyDown 25 1
Delay 64
KeyUp 25 1
Delay 64
KeyUp 30 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
