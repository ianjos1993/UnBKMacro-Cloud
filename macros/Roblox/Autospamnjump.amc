<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Macro created for game new game Blade Ball it spams instead of you and jumps to make it harder to block for enemy.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 9 1
Delay 02 ms
KeyDown 44 1
Delay 02 ms
KeyUp 44 1
Delay 02 ms
KeyUp 9 1
Delay 02 ms
KeyDown 44 1
Delay 02 ms
KeyUp 44 1
Delay 02 ms
LeftDown 1
Delay 02 ms
LeftUp 1</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>