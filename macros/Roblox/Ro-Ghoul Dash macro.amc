<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Binds dash to whatever key you press, making movement more time efficent(specifically double tapping W).</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 26 1
KeyUp 26 1
Delay 64
KeyDown 26 1
KeyUp 26 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>