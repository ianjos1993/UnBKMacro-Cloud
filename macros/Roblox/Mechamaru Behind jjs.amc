<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>For JJS(Jujutsu Shenanigans) this is the first ability using the special so its easier to hit on Mechamaru (Puppet Master)</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 21 1
Delay 10 ms
KeyUp 21 1
Delay 10 ms
KeyDown 30 1
Delay 10 ms
KeyUp 30 1
Delay 10 ms</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>