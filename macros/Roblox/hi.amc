<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Этот макрос предназначен для быстрой отправки слова "привет" в чат
чтобы его использовать просто нажмите назначенную вами кнопку  и текст отправится автоматически.
</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 84 1
Delay 64
KeyUp 84 1
Delay 64
SetLang ru-RU
KeyDown 10 1
Delay 64
KeyUp 10 1
Delay 64
KeyDown 11 1
Delay 64
KeyUp 11 1
Delay 64
KeyDown 5 1
Delay 64
KeyUp 5 1
Delay 64
KeyDown 7 1
Delay 64
KeyUp 7 1
Delay 64
KeyDown 23 1
Delay 64
KeyUp 23 1
Delay 64
KeyDown 17 1
Delay 64
KeyUp 17 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>