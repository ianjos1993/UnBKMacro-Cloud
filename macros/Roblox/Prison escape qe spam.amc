<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Used to spam Q and E for anything you are doing in game. You can customize it very easy. I used it to read and to make muscles in short time.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 8 1
Delay 64
KeyUp 8 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>