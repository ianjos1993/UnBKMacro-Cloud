<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Used in roblox basketball legends, this macro will automatically give you a perfect eurostep which can be usefull to get away from people guarding you and get an easy 2 pointer</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 26 1
Delay 64
KeyDown 9 1
Delay 200 ms
KeyUp 9 1
Delay 64 ms
KeyDown 8 1
Delay 329 ms
KeyUp 8 1
Delay 64
KeyUp 26 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>