<Root>
  <DefaultMacro>
    <Major>Da hood macro</Major>
    <Description>so basically its an dh macro u can use it on TG if u want, i recommend to use they key "q" if ur on a qwerty and "a" if ur on an azerty keyboard</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 12 1
Delay 1 ms
KeyUp 12 1
Delay 1 ms
KeyDown 18 1
Delay 1 ms
KeyUp 18 1
Delay 1 ms</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>