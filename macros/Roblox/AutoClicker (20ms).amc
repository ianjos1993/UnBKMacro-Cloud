      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 20
LeftUp 1
Delay 20
LeftDown 1
Delay 20
LeftUp 1
Delay 20
LeftDown 1
Delay 20
LeftUp 1
Delay 20
LeftDown 1
Delay 20
LeftUp 1
Delay 20
LeftDown 1
Delay 20
