<Root>
  <DefaultMacro>
    <Major>LOCKED</Major>
    <Description>Automatically chooses CF for the white team in LOCKED. Useful if you don't trust your teammates to be good strikers, aswell as if you join late and the striker spot isn't taken. Macro can only be used on 1920x1080p.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>MoveTo 1081 569
LeftDown 1
LeftUp 1
MoveTo 1371 379
LeftDown 1
LeftUp 1
MoveTo 1077 243
LeftDown 1
LeftUp 1
MoveTo 1296 390
LeftDown 1
LeftUp 1
MoveTo 945 638
LeftDown 1
LeftUp 1</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>