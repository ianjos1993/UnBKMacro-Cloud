<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Anti afk for roblox
Useful for waiting in a game
wont get afk kicked after 20 minutes of inactivity
</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 4 1
Delay 30
KeyUp 4 1
Delay 30
KeyDown 7 1
Delay 30
KeyUp 7 1
Delay 30</Syntax>
    </KeyDown>
    <Software>Roblox</Software>
  </DefaultMacro>
</Root>