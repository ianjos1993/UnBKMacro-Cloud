    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 64
KeyUp 30 1
Delay 64
LeftDown 1
Delay 64
LeftUp 1
Delay 64
KeyDown 31 1
Delay 64
KeyUp 31 1
Delay 64
LeftDown 1
Delay 64
LeftUp 1
GoWhile 1 1000
