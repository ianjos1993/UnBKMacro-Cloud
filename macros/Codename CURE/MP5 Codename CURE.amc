<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Макрос на MP5 (поддержка) подавляет при стрельбе большинство колебаний вверх/вниз (без прицела). Для игры Codename CURE</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 50 ms
MoveR 0 14
Delay 50 ms
MoveR 0 14
Delay 50 ms
MoveR 0 14
Delay 50 ms
MoveR 0 14
Delay 2100 ms
MoveR 0 -7
Delay 50 ms
MoveR 0 -7
Delay 50 ms
MoveR 0 -7
Delay 50 ms
LeftUp 1</Syntax>
    </KeyDown>
    <Software>Codename CURE</Software>
  </DefaultMacro>
</Root>