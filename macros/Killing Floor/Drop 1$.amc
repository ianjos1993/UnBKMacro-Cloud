KeyUp 30 1
Delay 1
KeyDown 88 1
Delay 1
KeyUp 88 1
Delay 1
KeyDown 53 1
Delay 1
KeyUp 53 1
Delay 1</Syntax>
    </KeyDown>
    <Software>Killing Floor</Software>
  </DefaultMacro>
</Root>