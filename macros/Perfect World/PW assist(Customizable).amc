ИСПОЛЬЗУЙ ШАБЛОНЫ ДЛЯ СВОЕГО СКРИПТА
#region -= ШАБЛОНЫ ТУТ =-
    С помощью этих шаблонов создаем свой скрипт!
    Если используешь, убирай две косухи перед кодом - 
    здесь он закомментирован, что бы не учавствовал в коде!
    #region -= Выбор Окна =-
        Открывает n-ое окно вместо n - ставишь номер окна.
        //SendDOWN(Win);
        //Send(n, 64);
        //SendUP(Win);
    #endregion   
    #region -= Ассист =-
    Здесь n - это кнопка с ассистом на вашей панели
    //SendDown(Shift, 64);
    //SendDown(1, 64);
    //SendUP(Shift,64);
    //SendUP(1, 64);
    //SendDown(n, 64);
    //SendUP(n, 64);
    #endregion
#endregion

//Включение второго окна
SendDOWN(Win);
Send(2, 64);
SendUP(Win);
//Берем ассист во втором окне, на панеле он стоит под клавишей F1
SendDown(Shift, 64);
SendDown(1, 64);
SendUP(Shift,64);
SendUP(1, 64);
SendDown(F1, 64);
SendUP(F1, 64);
