Delay 187 ms
KeyUp 43 1
Delay 507 ms
KeyDown 30 1
Delay 94 ms
KeyUp 30 1
Delay 27036 ms
KeyDown 58 1
Delay 1865 ms
KeyUp 58 1
GoWhile 1 10000</Syntax>
    </KeyDown>
    <Software>Perfect World</Software>
  </DefaultMacro>
</Root>