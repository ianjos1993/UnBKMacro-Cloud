KeyUp 33 1
Delay 35 ms
KeyDown 29 1
Delay 35 ms
KeyUp 29 1
Delay 35 ms
KeyDown 227 1
Delay 35 ms
KeyDown 30 1
Delay 35 ms
KeyUp 227 1
Delay 35 ms
KeyUp 30 1</Syntax>
    </KeyDown>
    <Software>Perfect World</Software>
  </DefaultMacro>
</Root>