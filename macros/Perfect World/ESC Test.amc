<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Assassin - uses escape every 450 ms and then tabs to new mob (Used for single bosses).
Make sure to not have other mobs around when you activate this</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 41 1
KeyUp 41 1
KeyDown 43 1
KeyUp 43 1
Delay 450 ms</Syntax>
    </KeyDown>
    <Software>Perfect World</Software>
  </DefaultMacro>
</Root>