<Root>
  <DefaultMacro>
    <Major>Strand skating</Major>
    <Description>a new way to skate, manily works on staris and slopes but this helps you skate while using strand. goodluck and remember have fun!</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 32 1
Delay 400 ms
KeyDown 17 1
KeyDown 44 1
KeyUp 44 1
KeyDown 29 1
KeyUp 29 1</Syntax>
    </KeyDown>
    <Software>Destiny 2</Software>
  </DefaultMacro>
</Root>