Delay 109 ms
KeyUp 76 1
Delay 34 ms
KeyDown 76 1
Delay 143 ms
KeyUp 76 1
Delay 45 ms
KeyUp 74 1</Syntax>
    </KeyDown>
    <Software>Tekken 8</Software>
  </DefaultMacro>
</Root>