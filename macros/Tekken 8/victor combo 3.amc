KeyDown 73 1
Delay 71 ms
KeyUp 73 1
Delay 63 ms
KeyDown 73 1
Delay 104 ms
KeyUp 73 1
Delay 95 ms
KeyUp 7 1
Delay 72 ms
KeyUp 74 1</Syntax>
    </KeyDown>
    <Software>Tekken 8</Software>
  </DefaultMacro>
</Root>