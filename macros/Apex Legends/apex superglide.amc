<Root>
  <DefaultMacro>
    <Major>superglide</Major>
    <Description>superglide macro you can use on 144fps to make it easier without any configs just bind this to some key then hold W and the macro bind </Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 898 ms
KeyDown 44 1
Delay 141 ms
KeyUp 44 1
Delay 615 ms
KeyDown 224 1
Delay 22 ms
KeyDown 44 1
Delay 127 ms
KeyUp 44 1
Delay 9 ms
KeyUp 224 1</Syntax>
    </KeyDown>
    <Software>Apex Legends</Software>
  </DefaultMacro>
</Root>