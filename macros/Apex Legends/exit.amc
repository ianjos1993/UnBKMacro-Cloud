<Root>
  <DefaultMacro>
    <Major>Fast exit</Major>
    <Description>This macro isn't anything special, but it helps me avoid crooked fingers. By setting this key to C, for example, I can easily get out of a death box as quickly as possible without putting my hand or fingers in an awkward position.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 41 1
KeyUp 41 1</Syntax>
    </KeyDown>
    <Software>Apex Legends</Software>
  </DefaultMacro>
</Root>