<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>you have to practise still the timing of the macro to successfully superglide in Apex Legends. And make sure your Jump is SPACE  and your crouch is CTRL</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 44 1
Delay 1 ms
KeyUp 44 1
Delay 3 ms
KeyDown 224 1
Delay 1 ms
KeyUp 224 1
Delay 1 ms</Syntax>
    </KeyDown>
    <Software>Apex Legends</Software>
  </DefaultMacro>
</Root>