<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Superglide working with 200fps 2560x1080. Easy working just bind any key you want and use it in timing</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 44 1
Delay 10 ms
KeyDown 224 1
Delay 128 ms
KeyUp 44 1
Delay 64
KeyUp 224 1</Syntax>
    </KeyDown>
    <Software>Apex Legends</Software>
  </DefaultMacro>
</Root>