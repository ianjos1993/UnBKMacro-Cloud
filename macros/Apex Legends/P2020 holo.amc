<Root>
  <DefaultMacro>
    <Major>P2020 holo macro</Major>
    <Description>this is the best macro for P2020 with x2 holo, press to start release to stop
1920 x 1080
dpi 1400
sens 1</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 49 ms
MoveR -2 -15
Delay 49 ms
MoveR -1 -15
Delay 49 ms
MoveR -1 -15
Delay 49 ms
MoveR -2 -15
Delay 49 ms
MoveR -1 -15
Delay 49 ms
MoveR -1 -15
Delay 49 ms
MoveR -1 -15
Delay 49 ms
LeftUp 1
Delay 49 ms</Syntax>
    </KeyDown>
    <Software>Apex Legends</Software>
  </DefaultMacro>
</Root>