<Root>
  <DefaultMacro>
    <Major>Apex Jitter Aim for 301 </Major>
    <Description>Bind macro to left mouse click, will have zero recoil when shooting
good for all weapon, thankyou for using this macro </Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR 3 3
Delay 8 ms
MoveR 3 -3
Delay 8 ms
MoveR -3 -3
Delay 8 ms
MoveR -3 3
Delay 8 ms</Syntax>
    </KeyDown>
    <Software>Apex Legends</Software>
  </DefaultMacro>
</Root>