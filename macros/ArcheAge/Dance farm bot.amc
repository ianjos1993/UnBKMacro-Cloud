Delay 64
KeyUp 20 1
Delay 64 ms
Goto 22
KeyUp 7 1
Delay 10 s
varE = 0
KeyDown 7 1
Delay 64 ms
KeyDown 43 1
Delay 64 ms
KeyUp 43 1
Delay 100 150 ms
varE = varE + 1
if varE == 15 Goto 17
GoColor 20 3 33,96,162 34,100,170 1 592 54
KeyUp 7 1
Delay 64
KeyDown 30 1
Delay 150 ms
GoColor 60 3 167,68,49 169,68,49 1 807 37
KeyDown 83 1
Delay 64
KeyUp 83 1
varE = 0
Delay 64
KeyDown 30 1
Delay 64 ms
KeyUp 30 1
varE = varE + 1
if varE == 20 Goto 47
Delay 64
GoColor 38 2 167,68,49 169,68,49 1 807 37
Goto 51
KeyDown 41 1
Delay 64
KeyUp 41 1
Delay 64
KeyDown 83 1
Delay 64
KeyUp 83 1
Goto 60
Delay 64
KeyDown 30 1
Delay 64
KeyUp 30 1
Delay 64 100 ms
GoColor 55 2 33,98,166 40,116,197 1 560 55
KeyUp 30 1
Delay 64
KeyDown 27 1
Delay 64
KeyUp 27 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Archeage</Software>
