<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Automatically uses Transference every 55 seconds so you can auto farm The Index while AFK

Set Transference keybind to 5 (or default)</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 34 1
Delay 64
KeyUp 34 1
Delay 2000 ms
KeyDown 34 1
Delay 64
KeyUp 34 1
Delay 55000 ms
GoWhile 1 1000000</Syntax>
    </KeyDown>
    <Software>Warframe</Software>
  </DefaultMacro>
</Root>