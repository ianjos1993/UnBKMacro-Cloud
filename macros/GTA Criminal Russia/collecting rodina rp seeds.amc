    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 100 ms
KeyDown 226 1
