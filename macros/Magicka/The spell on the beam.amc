      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 50 ms
KeyDown 9 1
Delay 50 ms
KeyDown 20 1
Delay 50 ms
