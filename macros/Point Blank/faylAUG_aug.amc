<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Point Blank

Макрос для контроля отдачи на AUG A3

Летит в точку, очень удобно стрелять по головам, используйте на здоровье.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 15 ms
LeftUp 1
MoveR 0 0
MoveR -2 0
MoveR 2 0</Syntax>
    </KeyDown>
    <Software>Point Blank</Software>
  </DefaultMacro>
</Root>