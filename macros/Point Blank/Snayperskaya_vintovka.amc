<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>To suppress gun's bursts recoil so that to ensure precise firepower
Applicable weapon: light machine guns, rifles, mini-submachine gun</Description>
    <Comment>Automatic Press Gun
</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>RightDown 1
