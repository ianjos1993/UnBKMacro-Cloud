<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>useful macro for AWP user to do quick scope
just bind this macro to right click
commonly sniper user bind into right click
enjoy</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 20 ms
KeyDown 32 1
Delay 18 ms
KeyDown 20 1
Delay 19 ms
KeyDown 30 1
Delay 17 ms
LeftDown 1
Delay 18 ms</Syntax>
    </KeyDown>
    <Software>Point blank</Software>
  </DefaultMacro>
</Root>