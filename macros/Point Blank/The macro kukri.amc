<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Макрос предназначен для кукри
__________________________________________________________________________________________________-
Данный макрос позволяет вам делать быстрые удары с кукри, желательно иметь быструю смену оружия, заходим, проверяем, тащим.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 34 1
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 64
KeyDown 20 1
Delay 64
KeyUp 20 1
Delay 15 ms
KeyUp 34 1
KeyDown 32 1
Delay 14 ms
KeyUp 32 1</Syntax>
    </KeyDown>
    <Software>Point blank</Software>
  </DefaultMacro>
</Root>