<Root>
  <DefaultMacro>
    <Major>Não Utilizar em outros jogos a n ser Point Blank</Major>
    <Description>Macro Super Recomendada para jogadores do jogo point blank, ainda mas para aqueles que adoram uma troca rapida e uma boa precisão</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 28 ms
LeftUp 1
Delay 28 ms
RightDown 1
Delay 28 ms
RightUp 1
Delay 28 ms
KeyDown 32 1
Delay 24 ms
KeyUp 32 1
Delay 24 ms
KeyDown 30 1
Delay 24 ms
KeyUp 30 1
Delay 24 ms</Syntax>
    </KeyDown>
    <Software>Point blank</Software>
  </DefaultMacro>
</Root>