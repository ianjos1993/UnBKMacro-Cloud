    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 81 1
KeyDown 6 1
Delay 64
KeyUp 6 1
Delay 64
Delay 64
KeyUp 81 1
Delay 600 ms
