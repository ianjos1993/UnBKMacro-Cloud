<Root>
  <DefaultMacro>
    <Major>macro revolver auto</Major>
    <Description>this is the best macro for an automatic revolver, click on press to start and release to stop and everything will go by itself
1920x1080
fov90
dpi 1200-1400
sens 0.5</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
GoWhile 1 2
Delay 50 ms
MoveR 0 -10
Delay 50 ms
MoveR 0 -10
Delay 50 ms
MoveR 0 -10
Delay 50 ms
MoveR 0 -10
Delay 50 ms
MoveR 0 -10
Delay 50 ms
LeftUp 1
Delay 50 ms</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
</Root>