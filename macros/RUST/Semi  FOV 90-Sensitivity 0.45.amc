<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Best automatic Semi weapon macro ( you dont even need to move your mouse)
you must set FOV 90 and sensitivity 0.45
</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 10 ms
MoveR 0 8
Delay 10 ms
MoveR 0 8
Delay 10 ms
MoveR 0 8
Delay 10 ms
MoveR 0 8
Delay 10 ms
MoveR 0 8
Delay 10 ms
LeftUp 1
Delay 13 ms</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
</Root>