<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Подавляет отдачу от арбалета,Для игры RUST, если есть вопросы,пишите в соответствующей теме ,отвечу.</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR -2 4
LeftUp 1</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
</Root>