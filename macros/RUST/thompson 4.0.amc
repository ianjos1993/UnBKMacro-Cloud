MoveR 0 -36
Delay 47 ms
MoveR 0 -36
Delay 47 ms
MoveR 0 -36
Delay 47 ms
MoveR 0 -36
Delay 47 ms
MoveR 0 -36
Delay 47 ms
LeftUp 1
Delay 47 ms</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
