      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 30 ms
MoveR 0 12
LeftUp 1
MoveR 0 0
Delay 54 ms</Syntax>
    </KeyDown>
