<Root>
  <DefaultMacro>
    <Major>macro auto sar</Major>
    <Description>this is the best macro for an automatic SAR click on press to start and release to stop and everything will go by itself
sens 0.5
dpi 1200-1400
1920x1080
fov 90

enjoy!</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
GoWhile 1 2
Delay 50 ms
MoveR 0 -13
Delay 50 ms
MoveR 0 -14
Delay 50 ms
MoveR 0 -13
Delay 50 ms
MoveR 0 -14
Delay 50 ms
MoveR 0 -13
Delay 50 ms
LeftUp 1
Delay 50 ms</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
</Root>