<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Обычный автокликер чтобы быстро стрелять с берданки
Крутая штука, на близких дистанциях норм
Удачи на серверах)</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 15 ms
MoveR 0 8
LeftUp 1
MoveR 0 0
Delay 45 ms</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
</Root>