<Root>
  <DefaultMacro>
    <Major>macro thompson high sens</Major>
    <Description>this macro worj for thompson with high sens like 1.3 - 1.5 1920 x 1080
press to start release to stop
fov 90
sens 1.2-1.5
dpi 1500</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 50 ms
MoveR 0 -25
Delay 50 ms
MoveR 0 -25
Delay 50 ms
MoveR 0 -25
Delay 50 ms
MoveR 0 -25
Delay 50 ms
MoveR 0 -25
Delay 50 ms
MoveR 0 -25
Delay 50 ms
LeftUp 1
Delay 50 ms</Syntax>
    </KeyDown>
    <Software>Rust</Software>
  </DefaultMacro>
</Root>