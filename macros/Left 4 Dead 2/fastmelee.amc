<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Simple fastmelee macro for left 4 dead 2. All things you have to do is just set which keys to use the macro. </Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 0 ms
KeyDown 30 1
Delay 390 ms
LeftUp 1
Delay 30 ms
KeyDown 31 1
Delay 40 ms
KeyUp 30 1
Delay 100 ms
KeyUp 31 1
Delay 40 ms</Syntax>
    </KeyDown>
    <Software>Left 4 Dead 2</Software>
  </DefaultMacro>
</Root>