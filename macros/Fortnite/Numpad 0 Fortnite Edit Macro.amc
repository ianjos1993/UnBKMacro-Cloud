<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>This is my fifth - seventh Fortnite Edit Macro that I have uploaded to BotMek. I enjoy making these, somewhat.</Description>
    <Comment>https://botmek.com - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 98 1
KeyUp 98 1
LeftDown 1
LeftUp 1
KeyDown 98 1
KeyUp 98 1</Syntax>
    </KeyDown>
    <Software>Fortnite</Software>
  </DefaultMacro>
</Root>