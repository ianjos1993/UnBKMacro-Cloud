<Root>
  <DefaultMacro>
    <Major>Combat Assult Rifle Recoil</Major>
    <Description>This reduces recoil on the combat assult rifle by constantly moving the mouse at about the pace of the gun downwards, since the gun has heavy recoil I have not made a macro that entire gets rid of it yet due to limited use of time.</Description>
    <Comment>25 scoped sens, 800 dpi, 28%, 24%</Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>MoveR 0 1
Delay 1 1 ms</Syntax>
    </KeyDown>
    <Software>Fortnite</Software>
  </DefaultMacro>
</Root>