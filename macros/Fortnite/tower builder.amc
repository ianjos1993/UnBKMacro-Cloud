<Root>
  <DefaultMacro>
    <Major>Tower</Major>
    <Description>Quickly builds a ramp and floor.  Uses standard key binds.  Can be set to repeat to build a tower quickly.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 43 1
Delay 150 ms
KeyUp 43 1
KeyDown 44 1
Delay 500 ms
KeyUp 44 1
KeyDown 6 1
Delay 10 ms
KeyUp 6 1
LeftDown 1
Delay 150 ms
LeftUp 1
Delay 100 ms
KeyDown 44 1
Delay 550 ms
KeyUp 44 1
KeyDown 27 1
Delay 10 ms
KeyUp 27 1
LeftDown 1
Delay 150 ms
LeftUp 1
KeyDown 43 1
Delay 50 ms
KeyUp 43 1
Delay 600 ms</Syntax>
    </KeyDown>
    <Software>Fortnite / Tower Builder</Software>
  </DefaultMacro>
</Root>