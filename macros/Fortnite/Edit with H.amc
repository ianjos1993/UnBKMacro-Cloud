<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Edit wtih H
If not comfortable change bind
Make your friends float in the air!
Have fun!
Easy edit bind for fortnite</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 11 1
Delay 64
LeftDown 1
Delay 64
LeftUp 1
Delay 64
KeyUp 11 1</Syntax>
    </KeyDown>
    <Software>Fortnite</Software>
  </DefaultMacro>
</Root>