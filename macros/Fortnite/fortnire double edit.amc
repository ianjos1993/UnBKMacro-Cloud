<Root>
  <DefaultMacro>
    <Major>Double edit Fortnite</Major>
    <Description>So this is double edit macros, that can help u double edit fast. U must pay with that controls: F - ramp, X - floor, Z - cone. U can use any sensivity. But u must edit by urself, Enjoy!</Description>
    <Comment>https://keyran.net - Free macros download</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 9 1
Delay 35 ms
KeyUp 9 1
Delay 35 ms
KeyDown 27 1
Delay 35 ms
KeyUp 27 1
Delay 35 ms
KeyDown 29 1
Delay 35 ms
KeyUp 29 1
Delay 35 ms</Syntax>
    </KeyDown>
    <Software>Fortnite</Software>
  </DefaultMacro>
</Root>