      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 31 1
KeyUp 31 1
Delay 300 ms
RightDown 1
Delay 64
