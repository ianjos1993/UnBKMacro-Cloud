    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 64
LeftUp 1
Delay 64
LeftDown 1
Delay 64
LeftUp 1
Delay 64</Syntax>
    </KeyDown>
    <Software>CS: GO</Software>
  </DefaultMacro>
</Root>