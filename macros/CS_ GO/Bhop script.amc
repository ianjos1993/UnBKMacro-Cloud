<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>---------------------------------------------------------------------
Bhop script that let you bhop easy</Description>
    <Comment>https://botmek.com - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 44 1
Delay 1 ms
KeyUp 44 1
Delay 1 ms
KeyDown 4 1
Delay 1 ms
KeyUp 4 1
Delay 1 ms
KeyDown 7 1
Delay 1 ms
KeyUp 7 1
Delay 1 ms</Syntax>
    </KeyDown>
    <Software>CS: GO</Software>
  </DefaultMacro>
</Root>