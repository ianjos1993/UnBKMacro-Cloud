<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>One click to fire 4 sequential bullets instantly and concentrate on the point of impactsf impacts.
Applicable Weapon: all guns
</Description>
    <Comment>4XFIRE
</Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
LeftUp 1
