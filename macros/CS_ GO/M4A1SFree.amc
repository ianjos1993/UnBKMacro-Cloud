      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
Delay 96 ms
MoveR 0 6
Delay 96 ms
MoveR 0 8
Delay 96 ms
MoveR 0 12
Delay 96 ms
MoveR 0 16
Delay 96 ms
LeftUp 1
Delay 2000 ms</Syntax>
    </KeyDown>
