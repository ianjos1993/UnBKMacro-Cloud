      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 38 1
Delay 24 ms
KeyUp 38 1
Delay 24 ms
LeftDown 1
Delay 24 ms
LeftUp 1
Delay 24 ms
RightDown 1
Delay 24 ms
RightUp 1
Delay 24 ms
KeyDown 30 1
Delay 24 ms
KeyUp 30 1
Delay 24 ms
