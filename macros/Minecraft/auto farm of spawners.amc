      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 240 ms
KeyUp 30 1
Delay 90 ms
LeftDown 1
