      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 31 1
Delay 1 ms
KeyUp 31 1
Delay 15 ms
LeftDown 1
