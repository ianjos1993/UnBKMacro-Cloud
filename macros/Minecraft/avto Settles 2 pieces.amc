      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 6 1
Delay 20
KeyUp 6 1
Delay 20
RightDown 1
Delay 20
RightUp 1
Delay 20
KeyDown 27 1
Delay 20
