Delay 20 ms
KeyUp 18 1
Delay 20 ms
KeyDown 9 1
Delay 20 ms
KeyUp 9 1
Delay 20 ms
KeyDown 9 1
Delay 20 ms
KeyUp 9 1
Delay 20 ms</Syntax>
    </KeyDown>
    <Software>Minecraft</Software>
  </DefaultMacro>
</Root>