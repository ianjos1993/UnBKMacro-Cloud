      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>RightDown 1
Delay 25 ms
RightUp 1
Delay 25 ms
RightDown 1
Delay 25 ms
RightUp 1
Delay 25 ms</Syntax>
    </KeyDown>
