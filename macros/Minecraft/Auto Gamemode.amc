Delay 28 ms
KeyUp 8 1
Delay 28 ms
KeyDown 30 1
Delay 28 ms
KeyUp 30 1
Delay 28 ms
KeyDown 88 1
Delay 28 ms
KeyUp 88 1
Delay 28 ms</Syntax>
    </KeyDown>
    <Software>Minecraft</Software>
  </DefaultMacro>
</Root>