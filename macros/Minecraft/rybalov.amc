<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>рыболов для того чтобы заробатывать деньги с неё подходит ковсем серверам анархии,скайблок а также сборки с модами </Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>Delay 1278 ms
RightDown 1
Delay 141 ms
RightUp 1
Delay 6727 ms
RightDown 1
Delay 152 ms
RightUp 1
Delay 135 ms
GoWhile 1 86400000</Syntax>
    </KeyDown>
    <Software>Minecraft</Software>
  </DefaultMacro>
</Root>