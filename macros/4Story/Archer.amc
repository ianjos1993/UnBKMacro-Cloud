<Root>
  <DefaultMacro>
    <Major>Meilleur</Major>
    <Description>Ну скилы ставим
F6 - Остриё стрелы
F7 - Точный выстрел
F8 - Стрельба в движении
F8 - Вакуумная бомба</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 63 1
Delay 0 ms
KeyUp 63 1
Delay 0 ms
KeyDown 22 1
Delay 48 ms
KeyUp 22 1
Delay 48 ms
KeyDown 64 1
Delay 0 ms
KeyUp 64 1
Delay 0 ms
KeyDown 22 1
Delay 48 ms
KeyUp 22 1
Delay 48 ms
KeyDown 65 1
Delay 0 ms
KeyUp 65 1
Delay 0 ms
KeyDown 22 1
Delay 48 ms
KeyUp 22 1
Delay 48 ms
KeyDown 66 1
Delay 0 ms
KeyUp 66 1
Delay 0 ms</Syntax>
    </KeyDown>
    <Software>4STORY</Software>
  </DefaultMacro>
</Root>