KeyUp 36 1
Delay 64
KeyDown 35 1
Delay 64
KeyUp 35 1
Delay 64
KeyDown 34 1
Delay 64
KeyUp 34 1
Delay 64
KeyDown 32 1
Delay 500 ms
KeyUp 32 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Raft</Software>
  </DefaultMacro>
</Root>