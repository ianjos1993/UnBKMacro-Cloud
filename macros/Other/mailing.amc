Delay 100 ms
KeyDown 88 1
Delay 100 ms
KeyUp 88 1
Delay 700 ms
GoWhile 1 2900</Syntax>
    </KeyDown>
    <Software>вотсапп веб</Software>
  </DefaultMacro>
</Root>