    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 224 1
Delay 64
KeyDown 227 1
Delay 64
KeyDown 79 1
Delay 64
KeyUp 224 1
Delay 64
KeyUp 227 1
Delay 64
KeyUp 79 1
Delay 64</Syntax>
    </KeyDown>
