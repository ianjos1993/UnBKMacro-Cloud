<Root>
  <DefaultMacro>
    <Major>мой макрос 2</Major>
    <Description>- Уменьшает отдачу 
- Ставить мышь на 30
- Ставим на левую кнопку мыши , включаем и наслаждаемся игрой </Description>
    <Comment>макрос</Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>LeftDown 1
MoveR 0 1
Delay 6 ms
MoveR 0 1
Delay 6 ms
MoveR 1 1
Delay 7 ms
MoveR 0 1
Delay 6 ms
MoveR 0 1
Delay 6 ms
MoveR 0 1
Delay 6 ms
MoveR 0 1
Delay 7 ms
MoveR 1 1
Delay 6 ms
MoveR 0 1
Delay 6 ms
MoveR 0 1
LeftUp 1</Syntax>
    </KeyDown>
    <Software>Calicer</Software>
  </DefaultMacro>
</Root>