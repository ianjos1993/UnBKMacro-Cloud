<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>МАКРОС ДЛЯ КАРАВАЯ БЕЗ РУКОЯТКИ ОТДАЧИ!!!!ПОСТАВИЛ ЧУВСТВИТЕЛЬНОСТЬ НА 69.9,РАЗРЕШЕНИЕ 1440X900, DPI СКАЗАТЬ МОГУ МЫШКА ОТ SOLARIS.ПОСТАВИЛ НА РЕЖИМЫ С БОТАМИ (ДЛЯ ИГРОКОВ  НЕ СОВЕТУЮ, МОГУТ СПАЛИТЬ!!!)И ПОГНАЛ РАЗНОСИТЬ БОТОВ.Ставить на ЛЕВУЮ КНОПКУ МЫШИ(ЛКМ).ДАННЫЙ МАКРОС НУЖНО НЕМНОГО ИЗМЕНИТЬ СМОТРЯ КАК У КОГО, СНАЧАЛА ЗАДЕРЖКУ ДЕЛИМ НА 2, А ПОТОМ ПОДСТАРАИВАЕМ ПОД СЕБЯ, ЭТОТ ОБРАЗЕЦ  МОЖЕТ ПОДХОДИТЬ ДЛЯ ДЕДА.</Description>
    <Comment>МОЙ КОМЕНТАРИЙ ТАКОВ (ИДИ И РАЗНОСИ).</Comment>
    <GUIOption>
      <RepeatType>1</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax>rm</Syntax>
    </KeyUp>
