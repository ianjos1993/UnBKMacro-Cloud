<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>Tab spamming macro for tower of fantasy pvp. Use in combination with manual camera operation mode in settings</Description>
    <Comment></Comment>
    <GUIOption>
      <RepeatType>2</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 43 1
KeyUp 43 1
Delay 50 ms</Syntax>
    </KeyDown>
    <Software>Tower of Fantasy</Software>
  </DefaultMacro>
</Root>