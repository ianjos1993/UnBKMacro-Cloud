KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
KeyDown 27 1
KeyUp 27 1
GoWhile 1 10</Syntax>
    </KeyDown>
    <Software>Mount &amp; Blade: Warband</Software>
  </DefaultMacro>
</Root>