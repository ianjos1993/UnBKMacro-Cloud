      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 33 1
Delay 64 ms
KeyUp 33 1
Delay 64 ms
KeyDown 34 1
Delay 64 ms
KeyUp 34 1
Delay 64 ms
