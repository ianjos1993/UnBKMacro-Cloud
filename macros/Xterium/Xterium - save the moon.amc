//left(333, 1000); //Moon 8

//ВЫБОР ЛУНЫ
left(108, 1048); //Планеты
sleep(500);
left(181, 885); //Moon 1
sleep(1000);

//ЗАДАНИЕ УКРЫТЬ ФЛОТ
left(235, 1045); //Орбита
sleep(1000);
left(169, 263); //Укрыть флот
sleep(1000);

//ВЫБОР ВРЕМЕНИ СЕЙВА
left(591, 320); //Выбор времени
sleep(100);
send(down); //1 ч
send(down); //2 ч
send(down); //4 ч
send(down); //8 ч
send(down); //12 ч
send(down); //32 ч
//send(down); //64 ч
sleep(100);
send(Enter); //Установить время
sleep(100);

//ВЫБОР ФЛОТА И РЕСУРСОВ
left(1140, 278); //Выбрать весь флот
sleep(50);
left(1421, 390); //Дейтерий
sleep(50);
left(1421, 360); //Кристалл
sleep(50);
left(1421, 330); //Металл

//ОТПРАВИТЬ ФЛОТ
left(1312, 433); //Отправить
sleep(1000);

