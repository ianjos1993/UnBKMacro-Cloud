//left(333, 885); //Planet 2
//left(181, 926); //Planet 3
//left(333, 926); //Planet 4
//left(181, 966); //Planet 5
//left(333, 966); //Planet 6
//left(181, 1000); //Planet 7
//left(333, 1000); //Planet 8

//ВЫБОР ПЛАНЕТЫ
left(200, 1048); //Планеты
sleep(500);
left(121, 845); //Planet 1
sleep(1000);

//ЗАДАНИЕ УКРЫТЬ ФЛОТ
left(350, 1045); //Орбита
sleep(1000);
left(169, 263); //Укрыть флот
sleep(1000);

//ВЫБОР ВРЕМЕНИ СЕЙВА
left(591, 320); //Выбор времени
sleep(100);
send(down); //1 ч
send(down); //2 ч
send(down); //4 ч
send(down); //8 ч
send(down); //12 ч
send(down); //32 ч
send(down); //64 ч
sleep(100);
send(Enter); //Установить время
sleep(100);

//ВЫБОР ФЛОТА И РЕСУРСОВ
//left(1140, 290); //Выбрать весь флот
left(1140, 360); //Выбрать БТ
sleep(50);
left(1421, 390); //Дейтерий
sleep(50);
left(1421, 360); //Кристалл
sleep(50);
left(1421, 330); //Металл

//ОТПРАВИТЬ ФЛОТ
left(1312, 433); //Отправить
sleep(1000);

