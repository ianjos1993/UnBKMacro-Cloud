<Root>
  <DefaultMacro>
    <Major></Major>
    <Description>When press num 1 your Support Skill automatically cast to yourself. This is aplicable to all Job in Ragnarok.
This macro use mouse movement to the center, and I use 1920x1080 px.</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 30 1
Delay 64
KeyUp 30 1
Delay 64
MoveTo 856 491
Delay 64
LeftDown 1
Delay 64
LeftUp 1
Delay 64</Syntax>
    </KeyDown>
    <Software>Ragnarok</Software>
  </DefaultMacro>
</Root>