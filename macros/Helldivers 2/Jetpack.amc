      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 224 1
Delay 40 ms
KeyUp 224 1
Delay 40 ms
KeyDown 81 1
Delay 40 ms
KeyUp 81 1
Delay 40 ms
KeyDown 82 1
Delay 40 ms
KeyUp 82 1
Delay 40 ms
KeyDown 82 1
Delay 40 ms
KeyUp 82 1
Delay 40 ms
KeyDown 81 1
Delay 40 ms
KeyUp 81 1
Delay 40 ms
