<Root>
  <DefaultMacro>
    <Major>Helldivers 2</Major>
    <Description>Вызов стратогемы Орбитальная воздушная бомба

Для правильной работы переделать управление в настройках на стрелки</Description>
    <Comment>https://keyran.net - Free macros download | Скачать бесплатные макросы </Comment>
    <GUIOption>
      <RepeatType>0</RepeatType>
    </GUIOption>
    <KeyUp>
      <Syntax></Syntax>
    </KeyUp>
    <KeyDown>
      <Syntax>KeyDown 224 1
Delay 35
KeyDown 79 1
Delay 35
KeyUp 79 1
Delay 35
KeyDown 79 1
Delay 35
KeyUp 79 1
Delay 35
KeyDown 79 1
Delay 35
KeyUp 79 1
Delay 35
KeyUp 224 1
Delay 35</Syntax>
    </KeyDown>
    <Software>Helldivers 2</Software>
  </DefaultMacro>
</Root>